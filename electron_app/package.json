{
  "name": "web-content-capture-app",
  "version": "1.0.0",
  "description": "Electron app for web content capture with Python and Playwright",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "electron": "*",
    "electron-builder": "*"
  },
  "build": {
    "appId": "com.webcapture.app",
    "productName": "Web Content Capture",
    "directories": {
      "output": "dist"
    },
    "extraResources": [
      {
        "from": "../osbot_electron",
        "to": "osbot_electron",
        "filter": ["**/*"]
      },
      "server.py",
      "client.py"
    ],
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage"
    }
  }
}
